# Copy to scripts/notify-release.env (gitignored) and fill in.
# Used by scripts/notify-release.mjs / .githooks/post-commit to broadcast a Web Push to all users
# when a commit message has a `Notify-Users:` line.

# Full URL of the backend's release-broadcast endpoint.
BROADCAST_URL=https://iames-students-club.onrender.com/api/broadcast/release

# Must exactly match BROADCAST_API_KEY in the backend's environment.
BROADCAST_API_KEY=
