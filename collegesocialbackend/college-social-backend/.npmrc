# bullmq declares an *optional* peer on redis>=5, but this project pins redis@4 for
# @socket.io/redis-adapter. npm 7+ still hard-errors on the version mismatch even though the peer
# is optional and bullmq actually uses its bundled ioredis, not node-redis. legacy-peer-deps makes
# npm install (here and on Render) resolve like npm 6 -- deps installed, peers not strictly gated.
legacy-peer-deps=true
