{
  "name": "college-social-backend",
  "version": "1.0.0",
  "description": "NestJS + MongoDB backend for a college-only social network (auth by college ID, chat, lecture/file/video sharing)",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "compress:legacy": "node dist/scripts/compress-legacy-images.js",
    "gen:openapi": "nest build && node dist/scripts/gen-openapi.js"
  },
