# Server
PORT=3001
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://shaheen:shaheen@cluster0.hksifli.mongodb.net/college-social

# Optional. Set this ONLY when running more than one backend instance -- it makes Socket.IO
# (chat / presence / call signaling) share state across processes via the Redis adapter, so a
# message sent on instance A reaches a socket connected to instance B. Leave blank for a single
# instance (the default): the in-memory adapter is used and nothing else changes.
# e.g. redis://default:password@host:6379
REDIS_URL=

# Free-text search engine. Blank/anything-but-"on" -> the app uses its built-in $text / $regex
# queries (works out of the box, no setup). Set to "on" AFTER creating the four Atlas Search
# indexes on your cluster (see docs/ATLAS-SEARCH.md) to get fuzzy, relevance-ranked search.
# Turning it on before the indexes exist is safe -- each search logs once and falls back.
ATLAS_SEARCH=
# Optional: override the index names if you didn't use the defaults from the docs.
# ATLAS_INDEX_POSTS=posts_search
# ATLAS_INDEX_QUESTIONS=questions_search
# ATLAS_INDEX_GROUPS=groups_search
# ATLAS_INDEX_USERS=users_search

# Auth
JWT_SECRET=shaheen@1122
# Access token lifetime -- kept short since refresh-token rotation (see src/auth/) handles
# staying logged in. Do not set this back to a long duration.
JWT_EXPIRES_IN=15m
# Refresh token (httpOnly cookie) lifetime, in days.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Uploads -- per-category max size in MB. Each is independent and optional; omit one to use its
# built-in default (see src/upload/multer.config.ts). The built-in defaults (photo/lecture/file: 10,
# video/audio: 100) match what a FREE Cloudinary account enforces on its own servers -- confirmed via
# cloudinary.api.usage()'s media_limits -- so raising these here only helps once the connected
# Cloudinary account is on a paid plan with higher/removed media_limits; otherwise Cloudinary itself
# will still reject the larger file regardless of what's set below.
# MAX_PHOTO_SIZE_MB=10
# MAX_COVER_PHOTO_SIZE_MB=10
# MAX_POST_IMAGE_SIZE_MB=10
# MAX_CHAT_BACKGROUND_SIZE_MB=10
# MAX_LECTURE_SIZE_MB=10
# MAX_GENERIC_FILE_SIZE_MB=10
# MAX_VIDEO_SIZE_MB=100
# MAX_AUDIO_SIZE_MB=100
# Source file for محوّل الملفات (src/convert) -- PDF/Word/PowerPoint/Excel converted in-process
# (SheetJS/mammoth/pdfkit/pptxgenjs), never uploaded to Cloudinary, so raise this freely.
# MAX_CONVERSION_SIZE_MB=25

# محوّل الملفات high-accuracy engine: Adobe PDF Services (big-site-grade PDF<->Office fidelity,
# incl. recovering Arabic text from bad font encodings). When BOTH are set, every conversion goes
# through Adobe and the local Poppler/LibreOffice pipeline is used only if the API call fails.
# Free tier: 500 document transactions/month. Get credentials (OAuth Server-to-Server) at
# https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html -- the generated
# pdfservices-api-credentials.json contains client_id and client_secret. Leave blank to stay local.
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# محوّل الملفات -- PDF -> Word/PowerPoint structural recovery via LlamaParse (LlamaCloud). An
# LLM-backed parser that reads a PDF's real structure: heading levels, bullet lists, and tables as
# row/column grids -- and keeps Arabic / RTL text and cells in reading order (Adobe's Export PDF
# reverses them). Only used when CONVERT_PDF_KEEP_TEXT=1 (below) turns off the default page-image
# path; then it's tried FIRST, with Adobe -> LibreOffice -> the flat pipeline as fallback. Free
# tier: 1000 pages/day, no card. Key ("llx-...") from https://cloud.llamaindex.ai (API Keys).
LLAMAPARSE_API_KEY=

# محوّل الملفات -- PDF -> Word/PowerPoint fidelity. By DEFAULT every PDF page is rendered to an
# image (MuPDF/WASM, no system binaries) and laid full-bleed onto a same-size Word page /
# PowerPoint slide, with an invisible selectable text layer behind it -- the output looks EXACTLY
# like the source (multi-column, RTL, graphics all intact) but the body isn't freely editable.
#   CONVERT_PDF_KEEP_TEXT=1        -> prefer editable text instead (LlamaParse/Adobe recovery).
#   CONVERT_PDF_IMAGE_DPI=144      -> raster resolution, 96-300 (higher = sharper + bigger file).
#   CONVERT_PDF_IMAGE_MAX_PAGES=300-> above this the page-image path bails to text recovery.
# CONVERT_PDF_KEEP_TEXT=
# CONVERT_PDF_IMAGE_DPI=144

# College email must exactly equal "<collegeId>COLLEGE_EMAIL_DOMAIN" (optional, leave blank to disable)
COLLEGE_EMAIL_DOMAIN=@iames.mans.edu.eg

# Email verification + password reset, sent via SMTP -- works with any provider. Recommended:
# Brevo (app.brevo.com), free tier, no domain and no 2-Step-Verification/app-password dance --
# just "single sender" verification (a one-click confirm link emailed to the sending address).
# After signing up: Senders, Domains & Dedicated IPs -> Senders -> add + verify your sending
# email, then SMTP & API -> SMTP tab -> copy the login (SMTP_USER) and generate a key (SMTP_PASS).
# Until all three of HOST/USER/PASS are set, codes are just logged to the server console instead
# of emailed.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000

# File uploads (Cloudinary -- https://cloudinary.com). Sign up, then grab these from the
# dashboard's "Account Details" section. Until all three are set, uploads fall back to local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI assistant. Defaults to Groq (https://console.groq.com/keys) -- free, fast, no credit card
# needed: sign up, create a key, paste it below. Any OpenAI-compatible provider works by also
# overriding AI_BASE_URL/AI_MODEL. Leave AI_API_KEY blank to run against a stub reply instead --
# lecture search still works for real without it (see AiService for the degradation behavior).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Max user messages a student can send to the AI assistant per calendar day, across all their
# conversations. Resets at local midnight. Protects the provider quota/bill from a runaway user.
AI_DAILY_MESSAGE_QUOTA=100

# Web Push (VAPID). Generate with `npx web-push generate-vapid-keys`. Leave blank to disable
# phone/browser push notifications (the rest of the notification system still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Morning digest -- one Web Push per student each morning summarising their day (see
# DigestService). The cron now fires HOURLY and each student is pushed only in their preferred
# hour (notificationPrefs.digestHour, default 7 local). Override ONLY from a real process env var,
# not a .env file (a @Cron decorator argument is read before .env is loaded).
DIGEST_CRON=0 * * * *
DIGEST_TZ=Asia/Damascus

# Hours to add to the server's UTC clock for wall-clock comparisons (notification quiet hours,
# digest send hour). Default +3 (Asia/Damascus). Set if the user base is in another zone.
APP_TZ_OFFSET_HOURS=3

# Shared secret for POST /api/broadcast/release -- the repo's post-commit git hook uses it to push
# "a new update shipped" to every subscribed user when a commit message has a `Notify-Users:` line
# (see scripts/notify-release.env.example). Blank -> the endpoint is disabled (returns 503).
# Use any long random string, e.g. `openssl rand -hex 32`.
BROADCAST_API_KEY=
