# Committed on purpose (unlike .env.local): Next.js auto-loads this file for `next build` in
# production, so Vercel picks these up with zero manual env var setup in its dashboard. These are
# NEXT_PUBLIC_* values baked into the client bundle anyway, so there's nothing secret here --
# just the live Render backend's public URL.
#
# NEXT_PUBLIC_API_URL is relative on purpose -- see next.config.js's rewrites(). All API calls go
# through this app's own origin (proxied server-side to Render), so the refresh-token cookie is
# always first-party instead of a cross-site cookie browsers can silently drop.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=https://iames-students-club.onrender.com
NEXT_PUBLIC_ASSET_URL=https://iames-students-club.onrender.com

# This app's own public origin -- used as metadataBase for Open Graph / canonical URLs.
NEXT_PUBLIC_SITE_URL=https://iames-students-club.vercel.app

# Web Push public key -- must match VAPID_PUBLIC_KEY in the backend's .env.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Video uploads go straight from the browser to Cloudinary (re-encoded + split into sub-100MB
# segments in-browser first), skipping the Render server hop -- much faster on the free tier.
# Set to 0 to disable and fall back to the plain server upload route (e.g. if Cloudinary CORS
# ever misbehaves). Any other value, or unset, keeps it enabled.
NEXT_PUBLIC_DIRECT_UPLOAD=1

# Observability -- both are fully inert until their key is set (scripts load from the vendor
# CDN, no npm dependency). See lib/observability.ts.
#   Sentry: create a Browser JS project, copy its DSN here.
NEXT_PUBLIC_SENTRY_DSN=
#   PostHog: project API key + region host (https://eu.i.posthog.com or https://us.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
#   Optional: set by CI to tag Sentry releases (e.g. the git SHA).
NEXT_PUBLIC_COMMIT_SHA=
