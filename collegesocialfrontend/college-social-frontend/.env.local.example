# Base URL of the NestJS backend's REST API
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Base URL of the backend for Socket.IO (no /api suffix, the gateway adds /chat itself)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Base origin for resolving uploaded file paths (photos/lectures/videos/files)
NEXT_PUBLIC_ASSET_URL=http://localhost:3001

# Production (Render) values -- set these as the actual project env vars on Vercel,
# this file is just a local template and isn't read in production:
# NEXT_PUBLIC_API_URL=https://iames-students-club.onrender.com/api
# NEXT_PUBLIC_SOCKET_URL=https://iames-students-club.onrender.com
# NEXT_PUBLIC_ASSET_URL=https://iames-students-club.onrender.com
