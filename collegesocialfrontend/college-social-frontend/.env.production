# Committed on purpose (unlike .env.local): Next.js auto-loads this file for `next build` in
# production, so Vercel picks these up with zero manual env var setup in its dashboard. These are
# NEXT_PUBLIC_* values baked into the client bundle anyway, so there's nothing secret here --
# just the live Render backend's public URL.
#
# NEXT_PUBLIC_API_URL is relative on purpose -- see next.config.js's rewrites(). All API calls go
# through this app's own origin (proxied server-side to Render), so the refresh-token cookie is
# always first-party instead of a cross-site cookie browsers can silently drop.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=https://iames-students-club.onrender.com
NEXT_PUBLIC_ASSET_URL=https://iames-students-club.onrender.com

# Cloudflare Worker that reverse-proxies + edge-caches res.cloudinary.com (see
# /cloudflare/media-proxy.worker.js). Every Cloudinary image URL is rewritten to go through it
# (lib/media.ts), so repeat views are served from Cloudflare's CDN instead of burning
# Cloudinary's ~25 GB/month free-tier bandwidth. Remove this line to send media straight to
# Cloudinary again.
NEXT_PUBLIC_MEDIA_PROXY=https://media-proxy.iaems-club.workers.dev

# Set to 1 ONLY after the backend has CF_STREAM_ACCOUNT_ID / CF_STREAM_API_TOKEN /
# CF_STREAM_CUSTOMER_SUBDOMAIN configured on Render. New reels then upload to Cloudflare Stream
# (adaptive HLS) instead of Cloudinary. Existing reels keep playing unchanged.
NEXT_PUBLIC_STREAM_ENABLED=1

# This app's own public origin -- used as metadataBase so Open Graph / canonical URLs resolve
# absolutely (share cards, SEO). Change to the real production domain if it isn't this.
NEXT_PUBLIC_SITE_URL=https://iames-students-club.vercel.app

# Web Push public key -- must match VAPID_PUBLIC_KEY set on the Render backend. Safe to commit
# (it's a public key); the matching VAPID_PRIVATE_KEY is a Render-only secret, never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BC7ySzBzkY79id34X7Ysw6dn1hjFge6Z7hWXInwpJsNw-_4EPmm5K6kdnAkhVaE6x0rUK5_0vyQqBqodVNxd6yY

# --- Observability (Phase 0: analytics + error monitoring) --------------------------------------
# All NEXT_PUBLIC_* and vendor-public, safe to commit (same as the VAPID key above). Both stay
# fully inert until their key is filled in -- see lib/observability.ts. Fill these in, redeploy,
# and the whole event pipeline in docs/analytics-events.md turns on.
#
# Sentry: "Browser JavaScript" project DSN (public, write-only ingestion -- safe to commit).
NEXT_PUBLIC_SENTRY_DSN=https://9f56e780bfbfc8d5ed49a5ecf34bb273@o4512046834843648.ingest.us.sentry.io/4512046841593856
# PostHog: Project API key ("phc_..." -- public, write-only). NOT a Personal API key ("phx_...").
#   Host = your project's region: EU -> https://eu.i.posthog.com | US -> https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=phc_uChuSx783zSTgE5Z97o4hKKLmvoMfSfpueZc3HNUrbUq
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional: set by CI to tag Sentry releases with the deployed git SHA.
NEXT_PUBLIC_COMMIT_SHA=

# Chat end-to-end encryption (docs/e2ee-design.md). Blank -> the whole E2EE client is inert
# (no keygen, no encrypted messages). Set to 1 only alongside the backend's E2EE_ENABLED=1.
# Shelved 2026-09-08: E2EE means the server (and admins) can't read messages and a device that
# loses its keys loses history -- not wanted here. Left dormant; do NOT re-enable without also
# setting E2EE_ENABLED on Render + running scripts/disable-e2ee-cleanup in reverse.
NEXT_PUBLIC_E2EE_ENABLED=
